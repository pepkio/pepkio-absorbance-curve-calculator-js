{
  "name": "pepkio-absorbance-curve-calculator",
  "version": "0.1.1",
  "description": "Call the Pepkio Standard Curve & Concentration Calculator REST API from Node.js with typed ESM imports and a CLI.",
  "license": "MIT",
  "author": "Pepkio Team",
  "homepage": "https://www.pepkio.com/tools/absorbance-curve-calculator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-absorbance-curve-calculator-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-absorbance-curve-calculator-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": [
    "absorbance-curve-calculator",
    "standard-curve",
    "elisa",
    "bca",
    "bradford",
    "four-pl",
    "plate-reader",
    "assay",
    "immunoassay",
    "blank-subtraction",
    "dilution-factor",
    "model-comparison",
    "optical-density",
    "qc-flags",
    "pepkio",
    "laboratory-calculator",
    "concentration",
    "96-well",
    "bioinformatics",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-absorbance-curve-calculator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/client.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "undici": "^7.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  }
}
